# Anchor Recon configuration. Copy to .env (never commit .env) and load it with
#   node --env-file=.env app/dist/src/cli.js <command>
# Every offline command (ingest, match, review, report, attest --dry-run,
# verify, proof, simulate) works with none of these set.

# --- AI provider -----------------------------------------------------------
# heuristic (default, deterministic, what tests and the demo use) or llm.
RECON_PROVIDER=heuristic
# Anthropic Messages API key. Required for RECON_PROVIDER=llm (or
# --provider llm); the CLI refuses to start the LLM provider without it.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Customer name tokens are pseudonymised before any model call unless this is
# true. Set it only with a data-processing agreement in place.
LLM_PERSONAL_DATA_ALLOWED=false

# --- Data ------------------------------------------------------------------
# Directory holding platform-map.json, safeguarding.json, fee-schedule.json,
# bank-b-profile.json, customers.csv, travel-rule-log.csv. Default: data/seed
# (SIMULATED). Point it at the anchor's own config for real use.
RECON_CONFIG_DIR=

# --- Soroban registry (online commands only) --------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed recon_registry contract id (scripts/deploy-testnet.sh prints it).
RECON_REGISTRY_ID=

# Secret keys, each read only by the command that needs it. Prefer injecting
# them from a secret store at run time over keeping them in a file.
RECON_ADMIN_SECRET=        # registry init | rotate | auditor
RECON_SIGNER_SECRET=       # attest, attest --restate, registry holiday
RECON_ANYONE_SECRET=       # registry gaps (any funded account may call mark_gaps)
AUDITOR_PUBLIC=            # countersign: the auditor's G... address
AUDITOR_SECRET=            # countersign
